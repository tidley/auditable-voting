# Copy to /etc/tollgate/email-relay.env and chmod 600.
# Replace every placeholder before starting the service.

RELAY_HOST=127.0.0.1
RELAY_PORT=4320
RELAY_PUBLIC_URL=https://mail.example.org
RELAY_ALLOWED_COORDINATORS=npub1replace_with_the_coordinator_npub
# Optional: restrict the relay to specific elections.
# RELAY_ALLOWED_ELECTIONS=q_261113_125444
RELAY_ALLOWED_ORIGINS=https://tidley.github.io,https://vote.orangesync.tech
RELAY_STATE_DIR=/var/lib/tollgate-email-relay
RELAY_MAX_RECIPIENTS=1000
RELAY_MAX_RECIPIENTS_PER_DAY=500
RELAY_MAX_BATCHES_PER_HOUR=20

# SMTP credentials. Prefer OpenBao below for production.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=coordinator@example.org
SMTP_PASS=replace-with-the-mailbox-password
SMTP_FROM=coordinator@example.org

# Optional OpenBao KV v2 source. If OPENBAO_ADDR is set, these values take
# precedence and the relay fails closed when OpenBao is unavailable.
# OPENBAO_ADDR=https://openbao.example.org
# OPENBAO_TOKEN_FILE=/etc/tollgate/openbao-token
# OPENBAO_SECRET_PATH=secret/data/email/strato
# OPENBAO_CACHE_SECONDS=60
