# Optional base path for project-page deployments such as GitHub Pages.
# Leave unset for local development.
# VITE_BASE_PATH=/auditable-voting/

# Local coordinator email companion. Source this file or export the variables
# in the shell that starts `npm --prefix web run email:sender`. Never commit
# real values.
# EMAIL_SENDER_PORT=4319
# EMAIL_SENDER_STATE_DIR=./.email-sender-state

# SMTP transport (recommended for coordinator mail delivery).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=coordinator@example.org
# SMTP_PASS=app-password
# SMTP_FROM=coordinator@example.org

# cashu.email transport. Use NOMAIN_NSEC or `--nsec`; provide one unused
# 100-sat token per recipient via CASHU_TOKENS_FILE.
# NOMAIN_NSEC=nsec1...
# CASHU_TOKEN=cashuB...
# CASHU_TOKENS_FILE=/secure/path/cashu-tokens.txt
# CASHU_EMAIL_API=https://cashu.email
