# Optional base path for project-page deployments such as GitHub Pages.
# Leave unset for local development.
# VITE_BASE_PATH=/auditable-voting/

# Private coordinator CLI only. Never prefix SMTP settings with VITE_.
# The endpoint, STARTTLS policy, username and From identity are pinned in the sender.
# SMTP_PASSWORD_FILE=/home/YOUR_USER/.config/auditable-voting/smtp-password
# Or provision SMTP_PASSWORD through trusted secret storage (do not commit it).
# Set the current UTC month and verified prior account usage before sending.
# SMTP_QUOTA_MONTH=2026-11
# SMTP_MONTHLY_BASELINE=2
